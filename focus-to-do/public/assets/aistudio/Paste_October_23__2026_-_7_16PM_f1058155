          </div>
        </div>
        <div style="display:flex;align-items:center;gap:4px;flex-shrink:0">
          <span class="tabular" style="font-size:13px;font-weight:700;margin-right:4px">$${e.amount.toFixed(2)}</span>
          <button data-exp-edit="${e.id}" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
            <i class="fa-solid fa-pen" style="font-size:10px"></i></button>
          <button data-exp-del="${e.id}" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
            <i class="fa-regular fa-trash-can" style="font-size:10px"></i></button>
        </div>
      </div>`;
  }).join('') : emptyState('🧾','No expenses logged','Tap "Log" to record one.');
}

/* ═══════════════════════════════════════════════════════
   GPA
   ═══════════════════════════════════════════════════════ */
function gradeFor(total, final){
  if (final < 20) return { letter:'F', vlg:0, status:'Fail — final exam below 40%' };
  if (total >= 90) return { letter:'A+', vlg:4.0,  status:'Excellent' };
  if (total >= 85) return { letter:'A',  vlg:4.0,  status:'Excellent' };
  if (total >= 80) return { letter:'A-', vlg:3.75, status:'Excellent' };
  if (total >= 75) return { letter:'B+', vlg:3.5,  status:'Very Good' };
  if (total >= 70) return { letter:'B',  vlg:3.0,  status:'Very Good' };
  if (total >= 65) return { letter:'B-', vlg:2.75, status:'Good' };
  if (total >= 60) return { letter:'C+', vlg:2.5,  status:'Good' };
  if (total >= 50) return { letter:'C',  vlg:2.0,  status:'Satisfactory' };
  if (total >= 45) return { letter:'C-', vlg:1.75, status:'Unsatisfactory' };
  if (total >= 40) return { letter:'D',  vlg:1.0,  status:'Very Poor' };
  return { letter:'F', vlg:0, status:'Fail' };
}

function saveCourse(){
  const title = $('gpa-name').value.trim();
  if (!title){ toast('Enter a course name'); return; }
  const clamp = (id, min, max, fb) => {
    let v = parseFloat($(id).value);
    if (!Number.isFinite(v)) v = fb;
    v = Math.min(max, Math.max(min, v));
    $(id).value = v;
    return v;
  };
  const credits = clamp('gpa-credits', 1, 10, 3);
  const cont = clamp('gpa-cont', 0, 50, 0);
  const final = clamp('gpa-final', 0, 50, 0);
  const total = cont + final;
  const g = gradeFor(total, final);

  appData.courses.push({
    id: uid(), title, credits, continuous: cont, finalExam: final, totalMark: total,
    letter: g.letter, vlg: g.vlg, status: g.status, gpt: g.vlg * credits
  });
  saveData(); renderGPA(); renderAnalytics();
  $('modal-gpa').classList.add('hidden');
  $('gpa-name').value = '';
  toast(`Saved · ${g.letter} (${g.vlg.toFixed(2)})`);
}

function renderGPA(){
  const list = $('courses-list');
  if (!appData.courses.length){
    list.innerHTML = emptyState('🎓','No courses yet','Add one to start tracking your CGPA.');
    $('cgpa').textContent = '0.00';
    $('cgpa-meta').textContent = '0 credit hours';
    return;
  }
  let pts = 0, creds = 0;
  list.innerHTML = appData.courses.map(c => {
    pts += c.gpt; creds += c.credits;
    const failing = c.letter === 'F';
    return `
      <div class="card" style="padding:14px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div style="min-width:0">
          <p style="font-size:13.5px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(c.title)}</p>
          <p class="dim tabular" style="font-size:11.5px;margin-top:2px">
            ${c.credits} cr · ${c.continuous}/50 + ${c.finalExam}/50 = <b style="color:var(--text)">${c.totalMark}%</b>
          </p>
          <p style="font-size:11.5px;margin-top:2px;font-weight:600;color:${failing ? 'var(--danger)' : 'var(--primary)'}">${c.status}</p>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
          <div style="text-align:right">
            <p style="font-size:16px;font-weight:800;color:var(--primary)">${c.letter}</p>
            <p class="dim tabular" style="font-size:10.5px">${c.vlg.toFixed(2)}</p>
          </div>
          <button data-course-del="${c.id}" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
            <i class="fa-regular fa-trash-can" style="font-size:10px"></i></button>
