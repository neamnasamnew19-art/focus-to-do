/* ═══════════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════════ */
function applyResponsive(){
  const isDesktop = window.innerWidth >= 768;
  const sidebar = $('sidebar');
  const bottomNav = document.querySelector('nav');
  const menuBtn = $('btn-menu');

  if (isDesktop){
    sidebar.style.position = 'relative';
    sidebar.style.transform = 'translateX(0)';
    if (bottomNav) bottomNav.style.display = 'none';
    if (menuBtn) menuBtn.style.display = 'none';
  } else {
    sidebar.style.position = 'fixed';
    sidebar.style.transform = 'translateX(-100%)';
    if (bottomNav) bottomNav.style.display = 'flex';
    if (menuBtn) menuBtn.style.display = 'flex';
  }
}

/* ═══════════════════════════════════════════════════════
   WIRING
   ═══════════════════════════════════════════════════════ */
function bind(){
  $('btn-menu').addEventListener('click', openSidebar);
  $('scrim').addEventListener('click', closeSidebar);

  document.querySelectorAll('.nav').forEach(el =>
    el.addEventListener('click', () => switchTab(el.dataset.tab)));

  $('btn-theme').addEventListener('click', () =>
    applyTheme(!document.documentElement.classList.contains('dark')));

  document.querySelectorAll('.open-task').forEach(b =>
    b.addEventListener('click', () => openTaskModal()));
  $('save-task').addEventListener('click', saveTask);

  $('btn-open-expense').addEventListener('click', () => openExpenseModal());
  $('save-expense').addEventListener('click', saveExpense);

  $('open-gpa').addEventListener('click', () => $('modal-gpa').classList.remove('hidden'));
  $('save-gpa').addEventListener('click', saveCourse);
  $('gpa-quick').addEventListener('change', e => {
    const val = e.target.value;
    if (!val) return;
    const [title, credits] = val.split('|');
    $('gpa-name').value = title;
    $('gpa-credits').value = credits;
  });

  $('open-event').addEventListener('click', () => openEventModal());
  $('save-event').addEventListener('click', saveEvent);
  $('event-link').addEventListener('change', renderEventCats);

  $('cal-prev').addEventListener('click', () => {
    calCursor.setMonth(calCursor.getMonth() - 1);
    renderCalendar();
  });
  $('cal-next').addEventListener('click', () => {
    calCursor.setMonth(calCursor.getMonth() + 1);
    renderCalendar();
  });

  document.querySelectorAll('.mode-btn').forEach(b =>
    b.addEventListener('click', () => setMode(b.dataset.mode)));
  $('timer-toggle').addEventListener('click', toggleTimer);
  $('timer-reset').addEventListener('click', resetTimer);
  $('timer-skip').addEventListener('click', skipSession);
  $('pomo-chip').addEventListener('click', () => switchTab('today'));

  document.querySelectorAll('.range-btn').forEach(b =>
    b.addEventListener('click', () => {
      anaRange = b.dataset.range;
      renderAnalytics();
    }));

  document.querySelectorAll('.exp-filter').forEach(b =>
    b.addEventListener('click', () => {
      expFilter = b.dataset.filter;
      renderExpenses();
    }));

  $('page-icon').addEventListener('click', openEmojiPicker);
  $('icon-change').addEventListener('click', openEmojiPicker);
  $('emoji-random').addEventListener('click', () => {
    const all = Object.values(EMOJIS).flat();
    const pick = all[Math.floor(Math.random() * all.length)];
    setIcon(pick);
    $('modal-emoji').classList.add('hidden');
    toast('Icon updated');
  });
  $('emoji-remove').addEventListener('click', () => {
    setIcon(null);
    $('modal-emoji').classList.add('hidden');
    toast('Icon removed');
  });
  $('emoji-search').addEventListener('input', e => {
    const q = e.target.value.trim();
    if (!q){
      renderEmojiGrid();
      return;
    }
    const direct = [...q].filter(ch => /\p{Extended_Pictographic}/u.test(ch));
    const all = [];
    const seen = new Set();
    Object.values(EMOJIS).forEach(list => list.forEach(em => {
      if (!seen.has(em)){ seen.add(em); all.push(em); }
    }));
    const grid = $('emoji-grid');
    const tiles = [];
    if (direct.length){
      tiles.push(`<button class="emoji-cell" data-emoji="${direct[0]}"
        style="background:var(--primary-soft)">${direct[0]}</button>`);
    }
    tiles.push(...all.slice(0, 200).map(em =>
      `<button class="emoji-cell" data-emoji="${em}">${em}</button>`));
    grid.innerHTML = tiles.join('');
  });

  document.addEventListener('click', e => {
    const tab = e.target.closest('[data-emoji-tab]');
    if (tab){
      emojiTab = tab.dataset.emojiTab;
      $('emoji-search').value = '';
      renderEmojiTabs();
      renderEmojiGrid();
      return;
    }
    const cell = e.target.closest('[data-emoji]');
    if (cell){
      setIcon(cell.dataset.emoji);
      $('modal-emoji').classList.add('hidden');
      toast('Icon updated');
      return;
    }
  });

  $('cover-add').addEventListener('click', openCoverPicker);
  $('cover-change').addEventListener('click', openCoverPicker);
  $('cover-remove').addEventListener('click', () => {
    setCover(null);
    toast('Cover removed');
  });

  document.addEventListener('click', e => {
    const cell = e.target.closest('[data-cover]');
    if (cell){
      setCover(cell.dataset.cover);
      $('modal-cover').classList.add('hidden');
      toast('Cover updated');
      return;
    }
  });

  $('cover-url-set').addEventListener('click', () => {
    const url = $('cover-url').value.trim();
    if (!url){ toast('Paste an image URL first'); return; }
    if (!/^https?:\/\//i.test(url) && !/^data:image\//i.test(url)){
      toast('URL must start with http:// or https://');
      return;
    }
    setCover(`url("${url}") center/cover no-repeat`);
    $('modal-cover').classList.add('hidden');
    toast('Cover updated');
  });

  $('cover-file').addEventListener('change', e => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (file.size > 500 * 1024){
      toast('Image is over 500 KB — pick a smaller one');
      e.target.value = '';
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      setCover(`url("${reader.result}") center/cover no-repeat`);
      $('modal-cover').classList.add('hidden');
      toast('Cover updated');
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  $('btn-export').addEventListener('click', exportData);
  $('btn-import').addEventListener('click', () => $('import-file').click());
  $('import-file').addEventListener('change', e => {
    const f = e.target.files?.[0];
    if (f) importData(f);
    e.target.value = '';
  });

  $('btn-reset').addEventListener('click', async () => {
    if (!await confirmDialog('This erases everything permanently. There is no undo.')) return;
    localStorage.removeItem(STORE);
    localStorage.removeItem(TIMER_KEY);
    await Native.save({
      tasks:[], expenses:[], courses:[], events:[], pomoLog:{}, energy:0,
      page:{ icon: DEFAULT_ICON, cover: null }
    });
    location.reload();
  });

  document.querySelectorAll('[data-close]').forEach(b =>
    b.addEventListener('click', () => $(b.dataset.close).classList.add('hidden')));

  document.querySelectorAll('.modal').forEach(m =>
    m.addEventListener('click', e => { if (e.target === m) m.classList.add('hidden'); }));

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (!$('modal-confirm').classList.contains('hidden')){
      $('confirm-cancel').click();
      return;
    }
    const open = [...document.querySelectorAll('.modal')]
      .filter(m => !m.classList.contains('hidden'));
    if (open.length) open[open.length - 1].classList.add('hidden');
    else if (sidebarOpen) closeSidebar();
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && timer.running) tick();
  });
  window.addEventListener('focus', () => { if (timer.running) tick(); });

  let wasDesktop = window.innerWidth >= 768;
  window.addEventListener('resize', () => {
    const isDesktop = window.innerWidth >= 768;
    if (isDesktop !== wasDesktop){
      wasDesktop = isDesktop;
      if (isDesktop) closeSidebar();
      applyResponsive();
    }
  });
}

/* ═══════════════════════════════════════════════════════
   BOOT
   ═══════════════════════════════════════════════════════ */
async function init(){
  await Native.wait();
  const disk = await Native.load();
  if (disk && typeof disk === 'object' && (disk.tasks || disk.expenses || disk.courses || disk.events)){
    appData = Object.assign(appData, disk);
    ['tasks','expenses','courses','events'].forEach(k => {
      if (!Array.isArray(appData[k])) appData[k] = [];
    });
    if (!appData.pomoLog || typeof appData.pomoLog !== 'object') appData.pomoLog = {};
    if (!appData.page) appData.page = { icon: DEFAULT_ICON, cover: null };
    appData.events.forEach(ev => {
      if (!ev.category || !EVENT_CATS[ev.category]) ev.category = 'Other';
    });
  } else {
    loadLocal();
  }

  loadTimer();

  const savedTheme = localStorage.getItem(THEME_KEY);
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(savedTheme ? savedTheme === 'dark' : prefersDark);

  $('task-date').value = today();
  $('exp-date').value = today();
  $('event-date').value = today();

  applyResponsive();
  bind();
  renderAll();

  if (nativeReady){
    try {
      const p = await window.pywebview.api.data_dir();
      $('data-path').textContent = p + (navigator.userAgent.includes('Windows') ? '\\data.json' : '/data.json');
    } catch(e){
      $('data-path').textContent = 'Not available';
    }
  } else {
    $('data-path').textContent = 'Browser localStorage (running as a webpage, not a native app)';
  }

  setInterval(tick, 250);
}

window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>