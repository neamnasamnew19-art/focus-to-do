              <div style="width:100%;display:flex;flex-direction:column;justify-content:flex-end;
                border-radius:4px 4px 0 0;overflow:hidden;height:${h}%;background:var(--surface-2)">
                ${Object.keys(EXP_CATS).map(cat => {
                  const amt = b.cats[cat];
                  if (!amt) return '';
                  const seg = (amt / b.total) * 100;
                  return `<div style="height:${seg}%;background:${EXP_CATS[cat].color}" title="${cat}: $${amt.toFixed(2)}"></div>`;
                }).join('')}
              </div>
              <span style="font-size:10.5px;margin-top:8px;font-weight:600;color:var(--text-2)">${dayLetters[dt.getDay()]}</span>
              <span style="font-size:9px;color:var(--text-3)">${dt.getDate()}</span>
            </div>`;
          }).join('')}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px 12px;padding-top:12px;margin-top:12px;
          border-top:1px solid var(--border);justify-content:center">
          ${Object.keys(EXP_CATS).map(cat => `
            <div style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--text-2)">
              <span style="font-size:13px">${EXP_CATS[cat].emoji}</span>${cat}
            </div>`).join('')}
        </div>
      </div>`;
    return;
  }

  if (expFilter === 'monthly'){
    $('exp-title').textContent = 'Month by month';
    const monthTotals = {};
    appData.expenses.forEach(e => {
      const dt = parseDate(e.date);
      const key = `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}`;
      monthTotals[key] = (monthTotals[key] || 0) + e.amount;
    });
    const nowKey = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
    $('exp-total').textContent = `$${(monthTotals[nowKey] || 0).toFixed(2)}`;
    $('exp-label').textContent = now.toLocaleString('default', { month:'long', year:'numeric' });

    const keys = Object.keys(monthTotals).sort().reverse();
    const maxV = Math.max(...Object.values(monthTotals), 1);

    $('exp-list').innerHTML = keys.length ? `
      <div class="card" style="padding:16px">
        <h4 style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin-bottom:14px">Monthly totals</h4>
        <div style="display:flex;flex-direction:column;gap:14px">
          ${keys.map(k => {
            const [y,m] = k.split('-');
            const label = new Date(+y, +m-1, 1).toLocaleString('default', { month:'long', year:'numeric' });
            const amt = monthTotals[k];
            const p = Math.max((amt / maxV) * 100, 4);
            return `<div>
              <div style="display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:6px">
                <span style="font-weight:600">${label}</span>
                <span class="tabular" style="font-weight:700">$${amt.toFixed(2)}</span>
              </div>
              <div style="width:100%;height:6px;border-radius:3px;background:var(--surface-2);overflow:hidden">
                <div style="height:100%;width:${p}%;background:var(--primary);border-radius:3px"></div>
              </div>
            </div>`;
          }).join('')}
        </div>
      </div>` : emptyState('🧾','No expenses yet','Log one to see monthly totals.');
    return;
  }

  const isAll = expFilter === 'all';
  $('exp-title').textContent = isAll ? 'All expenses' : "Today's expenses";

  const filtered = appData.expenses
    .filter(e => isAll || e.date === d)
    .sort((a,b) => b.date.localeCompare(a.date) || b.id - a.id);

  const total = filtered.reduce((a,e) => a + e.amount, 0);
  $('exp-total').textContent = `$${total.toFixed(2)}`;
  $('exp-label').textContent = isAll ? 'Total across all time' : 'Spent today';

  $('exp-list').innerHTML = filtered.length ? filtered.map(e => {
    const c = EXP_CATS[e.category] || EXP_CATS.Other;
    return `
      <div class="card" style="padding:12px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div style="display:flex;align-items:center;gap:12px;min-width:0">
          <span style="font-size:18px">${c.emoji}</span>
          <div style="min-width:0">
            <p style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(e.title)}</p>
