  const toggleBtn = e.target.closest('[data-toggle]');
  if (toggleBtn){
    const t = appData.tasks.find(x => x.id === +toggleBtn.dataset.toggle);
    if (t){ t.done = !t.done; saveData(); renderTasks(); renderCalendar(); }
    return;
  }
  const editBtn = e.target.closest('[data-edit]');
  if (editBtn){ openTaskModal(+editBtn.dataset.edit); return; }

  const focusBtn = e.target.closest('[data-focus]');
  if (focusBtn){ setFocusTask(+focusBtn.dataset.focus); return; }

  const delBtn = e.target.closest('[data-delete]');
  if (delBtn){
    if (!await confirmDialog('This task and its pomodoro history will be permanently deleted.')) return;
    const id = +delBtn.dataset.delete;
    if (activeFocus === id) clearFocus();
    appData.tasks = appData.tasks.filter(x => x.id !== id);
    saveData(); renderTasks(); renderCalendar(); renderAnalytics();
    toast('Task deleted');
    return;
  }

  const expEdit = e.target.closest('[data-exp-edit]');
  if (expEdit){ openExpenseModal(+expEdit.dataset.expEdit); return; }

  const expDel = e.target.closest('[data-exp-del]');
  if (expDel){
    if (!await confirmDialog('This expense will be permanently removed.')) return;
    appData.expenses = appData.expenses.filter(x => x.id !== +expDel.dataset.expDel);
    saveData(); renderExpenses(); renderAnalytics();
    toast('Expense deleted');
    return;
  }

  const courseDel = e.target.closest('[data-course-del]');
  if (courseDel){
    if (!await confirmDialog('Remove this course and its grade?')) return;
    appData.courses = appData.courses.filter(x => x.id !== +courseDel.dataset.courseDel);
    saveData(); renderGPA(); renderAnalytics();
    toast('Course removed');
    return;
  }

  const eventEdit = e.target.closest('[data-event-edit]');
  if (eventEdit){ openEventModal(+eventEdit.dataset.eventEdit); return; }

  const eventDel = e.target.closest('[data-event-del]');
  if (eventDel){
    const id = +eventDel.dataset.eventDel;
    const ev = appData.events.find(x => x.id === id);
    const hasTask = ev?.linkedTaskId && appData.tasks.some(t => t.id === ev.linkedTaskId);
    const ok = await confirmDialog(hasTask
      ? 'Delete this event and its linked Pomodoro task?'
      : 'Delete this event?');
    if (!ok) return;
    if (hasTask){
      if (activeFocus === ev.linkedTaskId) clearFocus();
      appData.tasks = appData.tasks.filter(t => t.id !== ev.linkedTaskId);
    }
    appData.events = appData.events.filter(x => x.id !== id);
    saveData(); renderTasks(); renderCalendar(); renderAnalytics();
    toast('Event deleted');
    return;
  }
});

