function tomatoRow(act, est){
  const MAX = 6, shown = Math.min(est, MAX);
  let html = '<div style="display:flex;align-items:center;gap:4px">';
  for (let i=0;i<shown;i++) html += `<span class="tomato ${i<act?'on':''}"></span>`;
  html += '</div>';
  if (est > MAX) html += `<span class="dim tabular" style="font-size:10.5px">+${est-MAX}</span>`;
  return html;
}

