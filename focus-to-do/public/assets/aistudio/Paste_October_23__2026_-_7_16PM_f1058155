<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Focus To-Do</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --bg:#fff; --surface:#fff; --surface-2:#f7f7f5; --surface-3:#f1f1ef;
  --hover:rgba(55,53,47,.055); --border:rgba(55,53,47,.09); --border-strong:rgba(55,53,47,.16);
  --text:#37352f; --text-2:#787774; --text-3:#9b9b9b;
  --primary:#2383e2; --primary-hover:#1a70c4; --primary-ink:#fff; --primary-soft:rgba(35,131,226,.1);
  --danger:#eb5757; --danger-soft:rgba(235,87,87,.1);
  --shadow:rgba(15,15,15,.05) 0 0 0 1px, rgba(15,15,15,.1) 0 3px 6px, rgba(15,15,15,.2) 0 9px 24px;
  --font:'Plus Jakarta Sans',system-ui,sans-serif;
  --mono:'JetBrains Mono',monospace;
}
html.dark{
  --bg:#191919; --surface:#202020; --surface-2:#252525; --surface-3:#2c2c2c;
  --hover:rgba(255,255,255,.055); --border:rgba(255,255,255,.094); --border-strong:rgba(255,255,255,.155);
  --text:rgba(255,255,255,.81); --text-2:rgba(255,255,255,.46); --text-3:rgba(255,255,255,.34);
  --primary:#529cca; --primary-hover:#6aadd6; --primary-soft:rgba(82,156,202,.14);
  --danger:#ff7369; --danger-soft:rgba(255,115,105,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  height:100vh;background:var(--bg);color:var(--text);font-family:var(--font);
  font-size:14px;line-height:1.5;letter-spacing:-.005em;-webkit-font-smoothing:antialiased;
  overflow:hidden;display:flex;flex-direction:column;
}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:5px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-track{background:transparent}
button{font-family:inherit;border:none;background:none;cursor:pointer;color:inherit}
input,select,textarea{font-family:inherit}
.card{background:var(--surface);border:1px solid var(--border);border-radius:6px}
.soft{background:var(--surface-2);border:1px solid var(--border);border-radius:6px}
.dim{color:var(--text-2)}
.row{display:flex;justify-content:space-between;align-items:center}
.inp{width:100%;background:var(--surface-2);border:1px solid var(--border);border-radius:4px;padding:7px 10px;font-size:13px;color:var(--text);outline:none;transition:.15s}
.inp:focus{background:var(--surface);border-color:var(--primary);box-shadow:0 0 0 2px var(--primary-soft)}
.inp::placeholder{color:var(--text-3)}
select.inp{appearance:none;cursor:pointer;padding-right:28px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='%23787774' stroke-width='3'><path d='M6 9l6 6 6-6'/></svg>");
  background-repeat:no-repeat;background-position:right 10px center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;font-weight:600;font-size:13px;
  border-radius:4px;padding:6px 12px;transition:.15s;cursor:pointer;white-space:nowrap}
.btn:active{transform:translateY(.5px)}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-hover)}
.btn-ghost{color:var(--text-2)}
.btn-ghost:hover{background:var(--hover);color:var(--text)}
.btn-soft{background:var(--surface-2);color:var(--text);border:1px solid var(--border)}
.btn-soft:hover{background:var(--surface-3)}
.btn-danger{background:var(--danger);color:#fff}
.side-item{display:flex;align-items:center;gap:9px;padding:5px 9px;border-radius:4px;font-size:13.5px;
  font-weight:500;color:var(--text-2);width:100%;text-align:left;transition:.15s}
.side-item:hover{background:var(--hover);color:var(--text)}
.side-item.active{background:var(--primary-soft);color:var(--primary);font-weight:600}
.side-item i{width:16px;text-align:center;font-size:14px}
.side-label{padding:14px 9px 4px;font-size:10.5px;font-weight:700;color:var(--text-3);
  letter-spacing:.08em;text-transform:uppercase}
.chip{display:inline-flex;align-items:center;gap:4px;padding:1px 7px;border-radius:3px;font-size:11.5px;font-weight:600}
.pill{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:3px;font-size:12px;
  font-weight:600;background:var(--primary-soft);color:var(--primary)}
.chk{width:16px;height:16px;border-radius:3px;border:1.5px solid var(--border-strong);display:flex;
  align-items:center;justify-content:center;flex-shrink:0;transition:.12s;background:transparent;margin-top:3px}
.chk:hover{border-color:var(--primary);background:var(--primary-soft)}
.chk.on{background:var(--primary);border-color:var(--primary);color:#fff}
.chk i{font-size:9px}
.tomato{width:8px;height:8px;border-radius:50%;border:1.5px solid var(--primary);display:inline-block}
.tomato.on{background:var(--primary)}
.toast{background:var(--surface);border:1px solid var(--border);color:var(--text);padding:9px 14px;
  border-radius:6px;font-size:13px;font-weight:600;box-shadow:var(--shadow);opacity:0;transform:translateY(6px);
  transition:.2s;pointer-events:none;max-width:90vw;text-align:center}
.toast.show{opacity:1;transform:translateY(0)}
.fade{animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(2px)}to{opacity:1;transform:none}}
.tabular{font-variant-numeric:tabular-nums}
#timer-display{font-family:var(--mono);font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.045em}
.cat-btn{display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 4px;border-radius:4px;
  border:1px solid var(--border);font-size:11px;font-weight:600;color:var(--text-2);transition:.15s;width:100%}
.cat-btn:hover{background:var(--hover)}
.cat-btn.on{border-color:var(--c);color:var(--c);background:var(--c-soft)}
.emoji-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:20px;
  border-radius:4px;transition:.1s}
.emoji-cell:hover{background:var(--hover);transform:scale(1.15)}
.emoji-tab{padding:4px 9px;border-radius:4px;font-size:18px;line-height:1}
.emoji-tab:hover{background:var(--hover)}
.emoji-tab.on{background:var(--primary-soft)}
.cover-cell{aspect-ratio:16/6;border-radius:4px;cursor:pointer;border:1.5px solid transparent;transition:.12s;background-size:cover;background-position:center}
.cover-cell:hover{transform:scale(1.03)}
.cover-cell.on{border-color:var(--primary)}
.modal-bg{background:rgba(15,15,15,.35);backdrop-filter:blur(3px)}
.hidden{display:none!important}
@media(min-width:768px){
  #scrim{display:none!important}
  #sidebar{transition:none}
}
</style>
</head>
<body>

<!-- HEADER -->
<header style="height:44px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;
  padding:0 12px;background:var(--bg);border-bottom:1px solid var(--border);z-index:30">
  <div style="display:flex;align-items:center;gap:8px">
    <button id="btn-menu" class="btn-ghost" style="width:28px;height:28px;border-radius:4px;padding:0">
      <i class="fa-solid fa-bars" style="font-size:13px"></i>
    </button>
    <div style="width:24px;height:24px;border-radius:4px;background:var(--primary);color:#fff;
      display:flex;align-items:center;justify-content:center">
      <i class="fa-solid fa-check" style="font-size:10px"></i>
    </div>
    <span style="font-size:14.5px;font-weight:700;letter-spacing:-.02em">Focus To-Do</span>
  </div>
  <div style="display:flex;align-items:center;gap:6px">
    <div class="pill" id="energy-pill" title="Focus energy">
      <span>⚡</span><span id="energy-val" class="tabular">0</span>
    </div>
    <button id="btn-theme" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
      <i class="fa-solid fa-moon" style="font-size:12px"></i>
    </button>
  </div>
</header>

<!-- BODY -->
<div style="flex:1;display:flex;overflow:hidden;position:relative">
  <div id="scrim" class="hidden" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:30"></div>

  <aside id="sidebar" style="width:232px;flex-shrink:0;padding:8px;background:var(--surface-2);
    border-right:1px solid var(--border);z-index:40;position:absolute;height:100%;left:0;top:0;
    transform:translateX(-100%);transition:transform .2s;overflow-y:auto;
    display:flex;flex-direction:column;justify-content:space-between">
    <div>
      <button class="side-item" style="font-weight:700;color:var(--text);gap:6px">
        <span style="width:20px;height:20px;border-radius:4px;background:var(--primary);color:#fff;
          display:flex;align-items:center;justify-content:center;font-size:10px">
          <i class="fa-solid fa-check"></i>
        </span>
        <span>Focus To-Do</span>
      </button>
      <div class="side-label">Tasks &amp; Focus</div>
      <button data-tab="today" class="nav side-item active"><i class="fa-solid fa-list-check"></i><span>Today</span></button>
      <button data-tab="upcoming" class="nav side-item"><i class="fa-regular fa-calendar-days"></i><span>Upcoming</span></button>
      <button data-tab="pomo" class="nav side-item"><i class="fa-solid fa-stopwatch"></i><span>Pomodoro</span></button>
      <div class="side-label">Student Hub</div>
      <button data-tab="analytics" class="nav side-item"><i class="fa-solid fa-chart-simple"></i><span>Reports</span></button>
      <button data-tab="expenses" class="nav side-item"><i class="fa-solid fa-wallet"></i><span>Expenses</span></button>
      <button data-tab="gpa" class="nav side-item"><i class="fa-solid fa-graduation-cap"></i><span>GPA Tracker</span></button>
      <button data-tab="events" class="nav side-item"><i class="fa-regular fa-calendar"></i><span>Calendar</span></button>
    </div>
    <div>
      <button data-tab="settings" class="nav side-item"><i class="fa-solid fa-gear"></i><span>Settings</span></button>
    </div>
  </aside>

  <main id="main" style="flex:1;overflow-y:auto;background:var(--bg)">

    <!-- PAGE HEADER -->
    <div id="page-header">
      <div id="page-cover" class="hidden" style="position:relative;height:180px;overflow:hidden">
        <div id="cover-bg" style="position:absolute;inset:0;background-size:cover;background-position:center"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.18),transparent 60%)"></div>
        <div style="position:absolute;right:12px;top:12px;display:flex;gap:6px;opacity:0;transition:.15s" id="cover-controls">
          <button id="cover-change" style="font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:4px;
            background:rgba(0,0,0,.55);color:#fff;backdrop-filter:blur(8px)">
            <i class="fa-solid fa-image" style="font-size:10px;margin-right:4px"></i>Change cover
          </button>
          <button id="cover-remove" style="width:26px;height:26px;border-radius:4px;background:rgba(0,0,0,.55);
            color:#fff;backdrop-filter:blur(8px)">
            <i class="fa-solid fa-xmark" style="font-size:11px"></i>
          </button>
        </div>
      </div>
      <div style="max-width:768px;margin:0 auto;padding:0 16px">
        <div id="icon-row" style="display:flex;align-items:center;gap:6px;transition:margin .2s">
          <button id="page-icon" style="font-size:62px;line-height:1;padding:8px;margin-left:-8px;
            border-radius:6px;transition:.15s">⏱️</button>
          <button id="icon-change" class="icon-hint" style="font-size:11.5px;font-weight:600;padding:5px 9px;
            border-radius:4px;color:var(--text-3);opacity:0;transition:.15s">
            <i class="fa-regular fa-face-smile" style="font-size:10px;margin-right:4px"></i>Change icon
          </button>
          <button id="cover-add" class="icon-hint hidden" style="font-size:11.5px;font-weight:600;padding:5px 9px;
            border-radius:4px;color:var(--text-3);opacity:0;transition:.15s">
            <i class="fa-solid fa-image" style="font-size:10px;margin-right:4px"></i>Add cover
          </button>
        </div>
      </div>
    </div>

    <div style="max-width:768px;margin:0 auto;padding:20px 16px 100px">

      <div id="focus-banner" class="hidden card" style="padding:12px;align-items:center;
        justify-content:space-between;gap:12px;margin-bottom:20px;border-color:var(--primary);background:var(--primary-soft)">
        <div style="display:flex;align-items:center;gap:12px;min-width:0">
          <div style="width:32px;height:32px;border-radius:6px;background:var(--primary);color:#fff;
            display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0">🎯</div>
          <div style="min-width:0">
            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--primary)">Now focusing</div>
            <div id="focus-title" style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">—</div>
          </div>
        </div>
        <button data-tab="pomo" class="nav btn btn-primary" style="flex-shrink:0">Open timer</button>
      </div>

      <!-- TODAY -->
      <section id="tab-today" class="tab">
        <div class="row" style="margin-bottom:16px">
          <div>
            <h2 style="font-size:24px;font-weight:800;letter-spacing:-.025em">☀️ Today</h2>
            <p class="dim" id="today-sub" style="font-size:12.5px;margin-top:2px">—</p>
          </div>
          <button class="open-task btn btn-soft"><i class="fa-solid fa-plus" style="font-size:11px"></i> New</button>
        </div>
        <div id="today-list" style="display:flex;flex-direction:column;gap:6px"></div>
      </section>

      <!-- UPCOMING -->
      <section id="tab-upcoming" class="tab hidden">
        <div class="row" style="margin-bottom:16px">
          <div>
            <h2 style="font-size:24px;font-weight:800;letter-spacing:-.025em">📅 Upcoming</h2>
            <p class="dim" style="font-size:12.5px;margin-top:2px">Tasks scheduled ahead</p>
          </div>
          <button class="open-task btn btn-soft"><i class="fa-solid fa-plus" style="font-size:11px"></i> New</button>
        </div>
        <div id="upcoming-list" style="display:flex;flex-direction:column;gap:6px"></div>
      </section>

      <!-- POMODORO -->
      <section id="tab-pomo" class="tab hidden">
        <div style="margin-bottom:16px">
          <h2 style="font-size:24px;font-weight:800;letter-spacing:-.025em">🍅 Pomodoro</h2>
          <p class="dim" style="font-size:12.5px;margin-top:2px">Focus in 25-minute blocks</p>
        </div>

        <div class="card" style="padding:24px;text-align:center">
          <div style="margin-bottom:20px">
            <button id="pomo-chip" class="pill" style="max-width:100%">
              <span>🎯</span>
              <span id="pomo-task-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">No task selected</span>
            </button>
          </div>

          <div style="display:inline-flex;padding:2px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);margin-bottom:24px">
            <button data-mode="pomo" class="mode-btn btn" style="padding:5px 14px;font-size:12px">Focus</button>
            <button data-mode="short" class="mode-btn btn" style="padding:5px 14px;font-size:12px">Short</button>
            <button data-mode="long" class="mode-btn btn" style="padding:5px 14px;font-size:12px">Long</button>
          </div>

          <div style="position:relative;width:240px;height:240px;margin:0 auto 28px">
            <svg viewBox="0 0 200 200" style="width:100%;height:100%;transform:rotate(-90deg)">
              <circle cx="100" cy="100" r="88" fill="none" stroke="var(--surface-3)" stroke-width="4"/>
              <circle id="ring" cx="100" cy="100" r="88" fill="none" stroke="var(--primary)" stroke-width="4"
                      stroke-linecap="round" stroke-dasharray="552.92" stroke-dashoffset="0"
                      style="transition:stroke-dashoffset .35s linear, stroke .2s"/>
            </svg>
            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
              <div id="timer-display" style="font-size:46px;line-height:1">25:00</div>
              <div id="timer-label" class="dim" style="font-size:10.5px;font-weight:700;margin-top:10px;text-transform:uppercase;letter-spacing:.14em">Focus</div>
              <div id="timer-round" style="font-size:11px;margin-top:6px;color:var(--text-3)"></div>
            </div>
          </div>

          <div style="display:flex;align-items:center;justify-content:center;gap:8px">
            <button id="timer-reset" style="width:36px;height:36px;border-radius:50%;background:var(--surface-2);
              border:1px solid var(--border);color:var(--text-2)">
              <i class="fa-solid fa-rotate-left" style="font-size:13px"></i>
            </button>
            <button id="timer-toggle" class="btn btn-primary" style="width:120px;height:36px;border-radius:18px;font-size:13px">
              <i class="fa-solid fa-play" style="font-size:11px"></i> Start
            </button>
            <button id="timer-skip" style="width:36px;height:36px;border-radius:50%;background:var(--surface-2);
              border:1px solid var(--border);color:var(--text-2)">
              <i class="fa-solid fa-forward-step" style="font-size:13px"></i>
            </button>
          </div>

          <p class="dim" style="font-size:12px;margin-top:20px">
            <span id="pomo-count" class="tabular" style="font-weight:600;color:var(--text)">0</span> pomodoros today ·
            <span id="pomo-mins" class="tabular" style="font-weight:600;color:var(--text)">0</span> min focused
          </p>
        </div>
      </section>

      <!-- ANALYTICS -->
      <section id="tab-analytics" class="tab hidden">
        <div class="row" style="margin-bottom:16px">
          <div>
            <h2 style="font-size:24px;font-weight:800;letter-spacing:-.025em">📊 Reports</h2>
            <p class="dim" style="font-size:12.5px;margin-top:2px">Focus, tasks, spending &amp; academics</p>
          </div>
          <div style="display:inline-flex;padding:2px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border)">
            <button data-range="week" class="range-btn btn" style="padding:4px 10px;font-size:12px">7D</button>
            <button data-range="month" class="range-btn btn" style="padding:4px 10px;font-size:12px">30D</button>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px">
          <div class="card" style="padding:14px">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3)">⏱️ Focus time</p>
            <p id="ana-time" style="font-size:24px;font-weight:800;letter-spacing:-.03em;margin-top:6px">0h 0m</p>
            <p id="ana-pomos" class="dim" style="font-size:12px;margin-top:2px">0 pomodoros</p>
          </div>
          <div class="card" style="padding:14px">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3)">✅ Tasks</p>
            <p id="ana-tasks" style="font-size:24px;font-weight:800;letter-spacing:-.03em;margin-top:6px">0%</p>
            <p id="ana-ratio" class="dim" style="font-size:12px;margin-top:2px">0 of 0</p>
          </div>
          <div class="card" style="padding:14px">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3)">💰 Spending</p>
            <p id="ana-exp" style="font-size:24px;font-weight:800;letter-spacing:-.03em;margin-top:6px">$0.00</p>
            <p class="dim" style="font-size:12px;margin-top:2px">In range</p>
          </div>
          <div class="card" style="padding:14px">
            <p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3)">🎓 CGPA</p>
            <p id="ana-cgpa" style="font-size:24px;font-weight:800;letter-spacing:-.03em;margin-top:6px">0.00</p>
            <p class="dim" style="font-size:12px;margin-top:2px">Cumulative</p>
          </div>
        </div>

        <div class="card" style="padding:16px;margin-bottom:16px">
          <h3 style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin-bottom:12px">🔥 Daily focus</h3>
          <div id="chart-focus" style="display:flex;align-items:flex-end;gap:3px;height:128px;padding-top:12px"></div>
        </div>

        <div class="card" style="padding:16px">
          <h3 style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin-bottom:12px">💸 Spending by category</h3>
          <div id="chart-exp" style="display:flex;flex-direction:column;gap:12px"></div>
        </div>
      </section>

      <!-- EXPENSES -->
      <section id="tab-expenses" class="tab hidden">
        <div style="margin-bottom:16px">
          <h2 style="font-size:24px;font-weight:800;letter-spacing:-.025em">💰 Expenses</h2>
          <p class="dim" style="font-size:12.5px;margin-top:2px">Track where your money goes</p>
        </div>

        <div class="card" style="padding:20px;margin-bottom:16px">
          <div class="row" style="margin-bottom:16px;flex-wrap:wrap;gap:12px">
            <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3)">Overview</span>
            <div style="display:inline-flex;padding:2px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border)">
