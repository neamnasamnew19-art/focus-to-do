function renderTasks(){
  const t = today();
  const todayTasks = appData.tasks.filter(x => x.date === t);
  const upcoming = appData.tasks.filter(x => x.date !== t).sort((a,b) => a.date.localeCompare(b.date));

  $('today-list').innerHTML = todayTasks.length
    ? todayTasks.map(taskCard).join('')
    : emptyState('☕','No tasks for today','Add one to get started.');

  $('upcoming-list').innerHTML = upcoming.length
    ? upcoming.map(taskCard).join('')
    : emptyState('📅','Nothing upcoming','Your future tasks will appear here.');

  const done = todayTasks.filter(x => x.done).length;
  $('today-sub').textContent = todayTasks.length
    ? `${done} of ${todayTasks.length} done · ${todayTasks.reduce((a,x) => a + x.act, 0)} pomodoros logged`
    : 'No tasks scheduled';
}

