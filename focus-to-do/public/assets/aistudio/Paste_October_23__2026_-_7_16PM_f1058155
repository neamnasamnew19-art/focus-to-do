function loadLocal(){
  try {
    const raw = localStorage.getItem(STORE);
    if (raw) appData = Object.assign(appData, JSON.parse(raw));
  } catch(e){}
  ['tasks','expenses','courses','events'].forEach(k => { if (!Array.isArray(appData[k])) appData[k] = []; });
  if (!appData.pomoLog || typeof appData.pomoLog !== 'object') appData.pomoLog = {};
  if (!appData.page) appData.page = { icon: DEFAULT_ICON, cover: null };
  appData.tasks.forEach(t => { if (typeof t.act !== 'number') t.act = 0; if (!t.log) t.log = {}; });
  appData.events.forEach(ev => { if (!ev.category || !EVENT_CATS[ev.category]) ev.category = 'Other'; });
}

function saveData(){
  try { localStorage.setItem(STORE, JSON.stringify(appData)); } catch(e){}
  Native.save(appData);
}

function loadTimer(){
  try {
    const t = JSON.parse(localStorage.getItem(TIMER_KEY) || 'null');
    if (t && MODES[t.mode]) timer = Object.assign(timer, t);
  } catch(e){}
  if (timer.running && timer.endAt){
    const rem = Math.round((timer.endAt - Date.now())/1000);
    if (rem <= 0) { timer.running = false; timer.endAt = null; timer.remaining = timer.total; }
    else timer.remaining = rem;
  } else {
    timer.running = false;
    timer.total = MODES[timer.mode].seconds;
    if (!timer.remaining || timer.remaining > timer.total) timer.remaining = timer.total;
  }
}
