function renderCalLegend(){
  $('cal-legend').innerHTML = Object.entries(EVENT_CATS).map(([n, c]) =>
    `<span style="display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--text-2)">
      <span style="font-size:13px">${c.emoji}</span>${n}
    </span>`).join('');
}

function renderCalendar(){
  const y = calCursor.getFullYear(), m = calCursor.getMonth();
  $('cal-title').textContent = calCursor.toLocaleString('default', { month:'long', year:'numeric' });

  const firstDow = new Date(y, m, 1).getDay();
  const lead = firstDow === 0 ? 6 : firstDow - 1;
  const totalDays = new Date(y, m+1, 0).getDate();
  const t = today();

  let html = '';
  for (let i=0;i<lead;i++) html += `<div style="height:52px"></div>`;

  for (let d=1; d<=totalDays; d++){
    const dStr = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const tasks = appData.tasks.filter(x => x.date === dStr);
    const events = appData.events.filter(x => x.date === dStr);
    const total = tasks.length + events.length;
    const isToday = dStr === t;
    const isSel = dStr === calSelected;

    const ev = events[0];
    const chipHtml = ev
      ? (() => { const c = EVENT_CATS[ev.category] || EVENT_CATS.Other;
          return `<p style="font-size:9px;padding:1px 4px;border-radius:3px;overflow:hidden;
            text-overflow:ellipsis;white-space:nowrap;font-weight:600;
            background:${c.color}1a;color:${c.color}">${esc(ev.title)}</p>`; })()
      : tasks[0]
        ? `<p style="font-size:9px;padding:1px 4px;border-radius:3px;overflow:hidden;
           text-overflow:ellipsis;white-space:nowrap;font-weight:600;
           background:var(--surface-3);color:var(--text-2)">${esc(tasks[0].title)}</p>`
        : '';

    html += `
      <button data-cal="${dStr}"
        style="height:52px;border-radius:4px;padding:4px;display:flex;flex-direction:column;
        justify-content:space-between;text-align:left;
        background:${isSel ? 'var(--primary-soft)' : 'transparent'};
        border:1px solid ${isSel ? 'var(--primary)' : isToday ? 'var(--primary)' : 'var(--border)'};
        border-left-width:${isToday && !isSel ? '3px' : '1px'}">
        <div class="row" style="width:100%">
          <span class="tabular" style="font-size:11px;font-weight:${isToday?'700':'600'};
            color:${isToday ? 'var(--primary)' : 'var(--text)'}">${d}</span>
          ${total > 0 ? `<span style="width:4px;height:4px;border-radius:50%;
            background:${isSel ? 'var(--primary)' : 'var(--text-3)'}"></span>` : ''}
        </div>
        <div style="width:100%;overflow:hidden">
          ${chipHtml}
          ${total > 1 ? `<p class="tabular" style="font-size:8.5px;padding-left:2px;color:var(--text-3)">+${total-1}</p>` : ''}
        </div>
      </button>`;
  }
  $('cal-grid').innerHTML = html;
  renderAgenda();
}

function renderAgenda(){
  const d = calSelected;
  const tasks = appData.tasks.filter(t => t.date === d);
  const events = appData.events.filter(e => e.date === d).sort((a,b) => a.id - b.id);
  const count = tasks.length + events.length;

  $('agenda-title').textContent = parseDate(d).toLocaleDateString(undefined, {
    weekday:'long', month:'short', day:'numeric'
  });
  $('agenda-badge').textContent = `${count} item${count === 1 ? '' : 's'}`;

  if (!count){
    $('agenda').innerHTML = `<p class="dim" style="font-size:12px;text-align:center;padding:16px 0">Nothing scheduled.</p>`;
    return;
  }

  let html = '';
  if (events.length){
    html += `<p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin-bottom:6px">Events</p>`;
    html += events.map(ev => {
      const c = EVENT_CATS[ev.category] || EVENT_CATS.Other;
      const linked = ev.linkedTaskId ? appData.tasks.find(t => t.id === ev.linkedTaskId) : null;
      const isActive = linked && activeFocus === linked.id;
      return `
        <div class="soft" style="padding:10px;display:flex;align-items:center;justify-content:space-between;gap:12px">
          <div style="display:flex;align-items:center;gap:10px;min-width:0">
            <span style="width:24px;height:24px;border-radius:4px;display:flex;align-items:center;
              justify-content:center;flex-shrink:0;font-size:14px;
              background:${c.color}1a">${c.emoji}</span>
            <div style="min-width:0">
              <p style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(ev.title)}</p>
              <div style="display:flex;align-items:center;gap:6px;margin-top:2px;flex-wrap:wrap">
                ${catChip(ev.category)}
                ${linked ? `<span class="dim tabular" style="font-size:11px">🍅 ${linked.act}/${linked.est} · linked</span>` : ''}
              </div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:2px;flex-shrink:0">
            ${linked ? `<button data-focus="${linked.id}" class="${isActive ? 'btn btn-primary' : 'btn btn-ghost'}"
              style="padding:4px 10px;font-size:11.5px">Focus</button>` : ''}
            <button data-event-edit="${ev.id}" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
              <i class="fa-solid fa-pen" style="font-size:10px"></i></button>
            <button data-event-del="${ev.id}" style="width:28px;height:28px;border-radius:4px;color:var(--text-2)">
              <i class="fa-regular fa-trash-can" style="font-size:10px"></i></button>
          </div>
        </div>`;
    }).join('');
  }
  if (tasks.length){
    html += `<p style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin:${events.length ? '12px' : '0'} 0 6px">Tasks</p>`;
    html += tasks.map(t => `
      <div class="soft" style="padding:10px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div style="display:flex;align-items:center;gap:10px;min-width:0">
          <span class="tomato ${t.done ? 'on' : ''}"></span>
          <span style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
            ${t.done ? 'text-decoration:line-through;color:var(--text-2)' : ''}">${esc(t.title)}</span>
          ${t.cat ? catChip(t.cat) : ''}
        </div>
        <button data-focus="${t.id}" class="btn btn-ghost" style="padding:4px 10px;font-size:11.5px;flex-shrink:0">Focus</button>
      </div>`).join('');
  }
  $('agenda').innerHTML = html;
}

