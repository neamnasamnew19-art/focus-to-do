function openEventModal(id = null){
  const editing = id !== null;
  const ev = editing ? appData.events.find(x => x.id === id) : null;

  $('event-title-modal').textContent = editing ? 'Edit Event' : 'New Event';
  $('event-id').value = editing ? id : '';
  $('event-name').value = ev ? ev.title : '';
  $('event-date').value = ev ? ev.date : calSelected;
  $('event-est').value = (ev && ev.est) ? ev.est : 2;
  $('event-link').checked = ev ? !!ev.linkedTaskId : true;
  eventDraftCat = ev ? ev.category : 'Study';

  renderEventCats();
  $('modal-event').classList.remove('hidden');
  setTimeout(() => $('event-name').focus(), 60);
}

function saveEvent(){
  const id = $('event-id').value;
  const title = $('event-name').value.trim();
  const date = $('event-date').value;
  const cat = eventDraftCat;
  const canLink = POMO_CATS.includes(cat);
  const wantsLink = canLink && $('event-link').checked;
  const est = Math.min(20, Math.max(1, parseInt($('event-est').value) || 1));

  if (!title){ toast('Give the event a name'); return; }
  if (!date){ toast('Pick a date'); return; }

  if (id){
    const ev = appData.events.find(x => x.id === +id);
    if (!ev) return;
    ev.title = title; ev.date = date; ev.category = cat;

    const linked = ev.linkedTaskId ? appData.tasks.find(t => t.id === ev.linkedTaskId) : null;
    if (wantsLink){
      if (linked){
        Object.assign(linked, { title, date, est, cat });
      } else {
        const task = { id: uid(), title, est, act:0, date, done:false, log:{}, eventId: ev.id, cat };
        appData.tasks.push(task);
        ev.linkedTaskId = task.id;
      }
      ev.est = est;
    } else if (linked){
      if (activeFocus === linked.id) clearFocus();
      appData.tasks = appData.tasks.filter(t => t.id !== linked.id);
      ev.linkedTaskId = null;
      ev.est = null;
    }
  } else {
    const evId = uid();
    const ev = { id: evId, title, date, category: cat, linkedTaskId: null, est: null };
    if (wantsLink){
      const task = { id: uid(), title, est, act:0, date, done:false, log:{}, eventId: evId, cat };
      appData.tasks.push(task);
      ev.linkedTaskId = task.id;
      ev.est = est;
    }
    appData.events.push(ev);
  }

  saveData(); renderTasks(); renderCalendar(); renderAnalytics();
  $('modal-event').classList.add('hidden');
  toast(id ? 'Event updated' : (wantsLink ? 'Study event linked to Pomodoro' : 'Event added'));
}

/* ═══════════════════════════════════════════════════════
   IMPORT / EXPORT
   ═══════════════════════════════════════════════════════ */
function exportData(){
  const blob = new Blob([JSON.stringify(appData, null, 2)], { type:'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `focus-todo-${today()}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
  toast('Backup downloaded');
}

function importData(file){
  const reader = new FileReader();
  reader.onload = async () => {
    try {
      const data = JSON.parse(reader.result);
      if (!data || typeof data !== 'object') throw new Error('bad shape');
      if (!await confirmDialog('Importing replaces all current data. Continue?')) return;
      appData = Object.assign({
        tasks:[], expenses:[], courses:[], events:[], pomoLog:{}, energy:0,
        page:{ icon: DEFAULT_ICON, cover: null }
      }, data);
      ['tasks','expenses','courses','events'].forEach(k => {
        if (!Array.isArray(appData[k])) appData[k] = [];
      });
      if (!appData.pomoLog || typeof appData.pomoLog !== 'object') appData.pomoLog = {};
      if (!appData.page) appData.page = { icon: DEFAULT_ICON, cover: null };
      appData.events.forEach(ev => {
        if (!ev.category || !EVENT_CATS[ev.category]) ev.category = 'Other';
      });
      saveData();
      renderAll();
      toast('Backup restored');
    } catch(err){
      toast('That file could not be read');
    }
  };
  reader.readAsText(file);
}

