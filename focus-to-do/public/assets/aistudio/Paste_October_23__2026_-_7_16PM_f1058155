    $('exp-list').innerHTML = `
      <div class="card" style="padding:16px">
        <h4 style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-3);margin-bottom:12px">Daily breakdown</h4>
        <div style="display:flex;align-items:flex-end;gap:8px;height:176px;padding-top:16px">
          ${buckets.map(b => {
            const h = b.total > 0 ? Math.max((b.total/maxVal)*100, 8) : 3;
            const dt = parseDate(b.date);
