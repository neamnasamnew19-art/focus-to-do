/* ═══════════════════════════════════════════════════════
   ANALYTICS
   ═══════════════════════════════════════════════════════ */
function renderAnalytics(){
  const n = anaRange === 'week' ? 7 : 30;
  const days = lastN(n);
  const daySet = new Set(days);

  document.querySelectorAll('.range-btn').forEach(b => {
    const on = b.dataset.range === anaRange;
    b.style.background = on ? 'var(--surface)' : 'transparent';
    b.style.color = on ? 'var(--text)' : 'var(--text-2)';
    b.style.boxShadow = on ? '0 1px 2px rgba(15,15,15,.1)' : 'none';
  });

  let pomos = 0;
  days.forEach(d => { pomos += appData.pomoLog[d] || 0; });
  $('ana-time').textContent = fmtDur(pomos * 25);
  $('ana-pomos').textContent = `${pomos} pomodoro${pomos === 1 ? '' : 's'}`;

  const inRange = appData.tasks.filter(t => daySet.has(t.date));
  const doneCount = inRange.filter(t => t.done).length;
  const pct = inRange.length ? Math.round(doneCount / inRange.length * 100) : 0;
  $('ana-tasks').textContent = `${pct}%`;
  $('ana-ratio').textContent = `${doneCount} of ${inRange.length} tasks`;

  const expInRange = appData.expenses.filter(e => daySet.has(e.date));
  const expTotal = expInRange.reduce((a,e) => a + e.amount, 0);
  $('ana-exp').textContent = `$${expTotal.toFixed(2)}`;

  let pts = 0, creds = 0;
  appData.courses.forEach(c => { pts += c.gpt || 0; creds += c.credits || 0; });
  $('ana-cgpa').textContent = creds > 0 ? (pts / creds).toFixed(2) : '0.00';

  const values = days.map(d => appData.pomoLog[d] || 0);
  const max = Math.max(...values, 1);
  const step = n <= 7 ? 1 : 5;

  $('chart-focus').innerHTML = days.map((d,i) => {
    const v = values[i];
    const h = v > 0 ? Math.max(6, (v/max)*100) : 2;
    const dt = parseDate(d);
    const show = n <= 7 || i % step === 0 || i === days.length - 1;
    const lbl = n <= 7 ? ['S','M','T','W','T','F','S'][dt.getDay()] : (show ? String(dt.getDate()) : '');
    return `<div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:0">
      <div style="width:100%;border-radius:2px 2px 0 0;
        background:${v > 0 ? 'var(--primary)' : 'var(--surface-3)'};
        height:${h}%;min-height:2px"></div>
      <span style="font-size:9.5px;margin-top:6px;font-weight:600;color:var(--text-3)">${lbl}</span>
    </div>`;
  }).join('');

  const totals = {};
  Object.keys(EXP_CATS).forEach(c => totals[c] = 0);
  expInRange.forEach(e => { totals[e.category] = (totals[e.category] || 0) + e.amount; });

  const rows = Object.keys(EXP_CATS)
    .map(cat => ({ cat, amt: totals[cat] }))
    .filter(r => r.amt > 0)
    .sort((a,b) => b.amt - a.amt);

  $('chart-exp').innerHTML = rows.length
    ? rows.map(r => {
        const c = EXP_CATS[r.cat];
        const p = expTotal > 0 ? (r.amt / expTotal * 100) : 0;
        return `<div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:12.5px">
            <span style="display:flex;align-items:center;gap:8px;font-weight:600">
              <span style="font-size:14px">${c.emoji}</span>${r.cat}
            </span>
            <span class="dim tabular" style="font-weight:600">$${r.amt.toFixed(2)} · ${Math.round(p)}%</span>
          </div>
          <div style="width:100%;height:6px;border-radius:3px;background:var(--surface-2);overflow:hidden">
            <div style="height:100%;width:${p}%;background:${c.color};border-radius:3px"></div>
          </div>
        </div>`;
      }).join('')
    : `<p class="dim" style="font-size:12px;text-align:center;padding:16px 0">No expenses in this range.</p>`;
}

