const Native = {
  async wait(){
    for (let i=0;i<40;i++){
      if (window.pywebview?.api) { nativeReady = true; return true; }
      await new Promise(r => setTimeout(r, 50));
    }
    return false;
  },
  async save(obj){
    if (!window.pywebview?.api) return false;
    try {
      const path = await window.pywebview.api.save_local('data.json', JSON.stringify(obj));
      const el = $('data-path');
      if (el) el.textContent = path;
      return true;
    } catch(e){ console.warn('save error', e); return false; }
  },
  async load(){
    if (!window.pywebview?.api) return null;
    try {
      const raw = await window.pywebview.api.load_local('data.json');
      if (!raw) return null;
      return JSON.parse(raw);
    } catch(e){ console.warn('load error', e); return null; }
  }
};

