  $('modal-expense').classList.remove('hidden');
  setTimeout(() => $('exp-name').focus(), 60);
}

function saveExpense(){
  const id = $('exp-id').value;
  const title = $('exp-name').value.trim();
  const amount = parseFloat($('exp-amount').value);
  const category = $('exp-category').value;
  const date = $('exp-date').value;

  if (!title){ toast('Add a description'); return; }
  if (!Number.isFinite(amount) || amount <= 0){ toast('Enter a valid amount'); return; }
  if (!date){ toast('Pick a date'); return; }

  if (id){
    const e = appData.expenses.find(x => x.id === +id);
    if (e) Object.assign(e, { title, amount, category, date });
  } else {
    appData.expenses.push({ id: uid(), title, amount, category, date });
  }
  saveData(); renderExpenses(); renderAnalytics();
  $('modal-expense').classList.add('hidden');
  toast(id ? 'Expense updated' : 'Expense logged');
}

function renderExpenses(){
  const now = new Date(); now.setHours(0,0,0,0);
  const d = today();

  document.querySelectorAll('.exp-filter').forEach(b => {
    const on = b.dataset.filter === expFilter;
    b.style.background = on ? 'var(--surface)' : 'transparent';
    b.style.color = on ? 'var(--text)' : 'var(--text-2)';
    b.style.boxShadow = on ? '0 1px 2px rgba(15,15,15,.1)' : 'none';
  });

  if (expFilter === 'weekly'){
    $('exp-title').textContent = 'Last 7 days';
    const start = daysAgo(6);
    const end = new Date(); end.setHours(23,59,59,999);
    const weekly = appData.expenses.filter(e => {
      const dt = parseDate(e.date);
      return dt >= start && dt <= end;
    });
    const total = weekly.reduce((a,e) => a + e.amount, 0);
    $('exp-total').textContent = `$${total.toFixed(2)}`;
    $('exp-label').textContent = 'Spent in the last 7 days';

