/* ═══════════════════════════════════════════════════════
   TIMER
   ═══════════════════════════════════════════════════════ */
function setMode(mode, announce = true){
  timer.mode = mode;
  timer.running = false;
  timer.endAt = null;
  timer.total = MODES[mode].seconds;
  timer.remaining = timer.total;
  saveTimer(); renderTimer(); renderPomoExtras();
  if (announce) toast(`${MODES[mode].label} · ${Math.round(timer.total/60)} min`);
}

function toggleTimer(){
  if (timer.running){
    timer.remaining = Math.max(0, Math.round((timer.endAt - Date.now())/1000));
    timer.running = false; timer.endAt = null;
  } else {
    if (timer.remaining <= 0) timer.remaining = timer.total;
    timer.running = true;
    timer.endAt = Date.now() + timer.remaining * 1000;
  }
  saveTimer(); renderTimer(); renderPomoExtras();
}

function resetTimer(){
  timer.running = false;
  timer.endAt = null;
  timer.total = MODES[timer.mode].seconds;
  timer.remaining = timer.total;
  saveTimer(); renderTimer(); renderPomoExtras();
}

function skipSession(){
  timer.running = false; timer.endAt = null; timer.remaining = 0;
  completeSession(true);
}

function tick(){
  if (!timer.running) return;
  const rem = Math.max(0, Math.round((timer.endAt - Date.now())/1000));
  if (rem !== timer.remaining){ timer.remaining = rem; renderTimer(); }
  if (rem <= 0) completeSession(false);
}

function completeSession(skipped){
  const finished = timer.mode;
  timer.running = false;
  timer.endAt = null;

  if (finished === 'pomo' && !skipped){
    const d = today();
    appData.pomoLog[d] = (appData.pomoLog[d] || 0) + 1;
    appData.energy = (appData.energy || 0) + 10;

    if (timer.taskId){
      const t = appData.tasks.find(x => x.id === timer.taskId);
      if (t){
        t.act = (t.act || 0) + 1;
        t.log = t.log || {};
        t.log[d] = (t.log[d] || 0) + 1;
      }
    }
    saveData();
    renderTasks(); renderEnergy(); renderAnalytics(); renderCalendar(); renderFocusBanner();
    beep();
    toast('🍅 Session complete — +10 energy');
    const count = appData.pomoLog[d] || 0;
    setMode(count % 4 === 0 ? 'long' : 'short', false);
  } else if (finished !== 'pomo' && !skipped){
    beep();
    toast('Break over — ready to focus?');
    setMode('pomo', false);
  } else {
    setMode('pomo', false);
  }
  renderTimer(); renderPomoExtras(); saveTimer();
}

function renderTimer(){
  const m = Math.floor(timer.remaining / 60), s = timer.remaining % 60;
  $('timer-display').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  $('timer-label').textContent = MODES[timer.mode].label;

  const pct = timer.total > 0 ? timer.remaining / timer.total : 0;
  $('ring').style.strokeDashoffset = String(RING_C * (1 - pct));
  $('ring').style.stroke = MODES[timer.mode].stroke;

  $('timer-toggle').innerHTML = timer.running
    ? '<i class="fa-solid fa-pause" style="font-size:11px"></i> Pause'
    : '<i class="fa-solid fa-play" style="font-size:11px"></i> Start';

  document.querySelectorAll('.mode-btn').forEach(b => {
    const on = b.dataset.mode === timer.mode;
    b.style.background = on ? 'var(--surface)' : 'transparent';
    b.style.color = on ? 'var(--text)' : 'var(--text-2)';
    b.style.boxShadow = on ? '0 1px 2px rgba(15,15,15,.1)' : 'none';
  });

  document.title = timer.running
    ? `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')} · ${MODES[timer.mode].label}`
    : 'Focus To-Do';
}

function renderPomoExtras(){
